<Window x:Class="Assignment10._3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment10._3"
        mc:Ignorable="d"
        Title="Bill Gates' Garage Management" Height="450" Width="900">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="carGrid" IsReadOnly="True" Grid.Row="0" Margin="5" AutoGenerateColumns="True" SelectionChanged="carGrid_Select"  
                  PreviewMouseDown="Unselect_Click"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.5*"/>

            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="1" Background="Transparent" PreviewMouseDown="Unselect_Click">

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Label Content="Make" Width="60"/>
                    <TextBox x:Name="txtMake" Width="120" VerticalAlignment="Center" TextChanged="TextChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Label Content="Model" Width="60"/>
                    <TextBox x:Name="txtModel" Width="120" VerticalAlignment="Center" TextChanged="TextChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Label Content="Year" Width="60"/>
                    <TextBox x:Name="txtYear" Width="120" VerticalAlignment="Center" TextChanged="TextChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Label Content="Price" Width="60"/>
                    <TextBox x:Name="txtPrice" Width="120" VerticalAlignment="Center" TextChanged="TextChanged"/>
                </StackPanel>
            </StackPanel>

            <WrapPanel Grid.Column="1" Background="Transparent" PreviewMouseDown="Unselect_Click">

                <Button x:Name="btnAdd" Width="90" Margin="20,20,20,20" Content="Add" Click="btnAdd_Click"/>
                <Button x:Name="btnDelete" Width="90" Margin="20,20,20,20" Content="Delete" Click="btnDelete_Click"/>
                <Button x:Name="btnUpdate" Width="90" Margin="20,20,20,20" Content="Update" Click="btnUpdate_Click"/>
                <Label Content="VIN #" Width="60" Margin="20" FontSize="19" FontWeight="Bold"/>
                <TextBox x:Name="txtVin" Width="270" Height="33" RenderTransformOrigin="0.5,0.554" TextChanged="TextChanged"/>


            </WrapPanel>

            <StackPanel Grid.Column="2" Background="Transparent" PreviewMouseDown="Unselect_Click">
                <ListBox x:Name="listGarages" DisplayMemberPath="Location" HorizontalAlignment="Left" VerticalAlignment="Center" SelectionChanged="listGarages_SelectionChanged"/>
            </StackPanel>

        </Grid>


    </Grid>
</Window>
